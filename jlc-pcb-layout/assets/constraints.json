        {"rank": "P4", "what": "敏感小信号与模拟前端", "rule": "与数字/功率区用地隔开，远离热源与电感"},
        {"rank": "P5", "what": "其余阻容与离散件", "rule": "同类同封装朝向统一；阵列对齐；吸栅(IC 50-100mil / 小 SMD ≥25mil)"},
        {"rank": "P6", "what": "测试点 / MARK 基准点 / 丝印", "rule": "MARK ≥3 个非对称；测试点焊盘≥24mil、中心距≥60mil"}
      ]
    }
  },

