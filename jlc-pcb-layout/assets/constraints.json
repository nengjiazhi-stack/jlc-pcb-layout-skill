      "max_source_ohm": 10000,
      "filter_cap_nf": 100,
      "min_divider_current_ua": 10
    },

    "tvs": {
      "_note": "VRWM ≥ 1.1×工作电压（否则正常工作就漏电击穿），钳位电压 VC 必须低于被保护脚绝对最大额定值",
      "vrwm_mult": 1.1,
